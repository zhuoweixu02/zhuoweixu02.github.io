<div class="row publication-row">
  {% if project.redirect %}
    {% assign project_target_url = project.redirect %}
  {% elsif project.website %}
    {% assign project_target_url = project.website %}
  {% elsif project.pdf %}
    {% assign project_target_url = project.pdf %}
  {% else %}
    {% assign project_target_url = project.url | relative_url %}
  {% endif %}
  <div class="col col-sm-2 abbr">
    {% if project.img %}
      <a href="{{ project_target_url }}">
        {%
          include figure.liquid
          loading="eager"
          path=project.img
          sizes="200px"
          class="preview z-depth-1 rounded"
          alt=project.title
        %}
      </a>
    {% endif %}
  </div>

  <div id="{{ project.title | slugify }}" class="col-sm-8">
    <div class="title">
      <a
        href="{{ project_target_url }}"
        style="color: var(--global-text-color); text-decoration: none;"
      >
        {{ project.title }}
      </a>
    </div>
    <div class="author">{{ project.description }}</div>
    <div class="links">
      {% if project.github %}
        <a href="{{ project.github }}" class="btn btn-sm z-depth-0" role="button">Code</a>
      {% endif %}
      {% if project.website %}
        <a href="{{ project.website }}" class="btn btn-sm z-depth-0" role="button">Website</a>
      {% endif %}
      {% if project.pdf %}
        <a href="{{ project.pdf }}" class="btn btn-sm z-depth-0" role="button">PDF</a>
      {% endif %}
      {% if project.report %}
        <a href="{{ project.url | relative_url }}" class="btn btn-sm z-depth-0" role="button">REPORT</a>
      {% endif %}
    </div>
  </div>
</div>
